<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ships wwwroot/yaeger-browser.js as _content/Yaeger.Browser/yaeger-browser.js. -->
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yaeger.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yaeger.Core\Yaeger.Core.csproj" />
  </ItemGroup>
</Project>
